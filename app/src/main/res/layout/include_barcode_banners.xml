<?xml version="1.0" encoding="utf-8"?>
<!--
  Avisos de una lectura de codigo de barras, compartidos por el conteo normal
  y el guiado (se incluyen dentro de un LinearLayout vertical).
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout"
    tools:orientation="vertical">

    <!-- Aviso ambar: el codigo es de otra presentacion u otro producto. -->
    <LinearLayout
        android:id="@+id/barcodeMismatchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_banner_warn"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        tools:visibility="visible">
        <TextView
            android:id="@+id/tvBarcodeMismatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/md_theme_onTertiaryContainer"
            tools:text="El código 7500025005095 es de 1100 · REAL FLEX NF BLANCO en 4 LTS." />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBarcodeDiscard"
                style="@style/App.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/md_theme_onTertiaryContainer"
                android:textColor="@color/md_theme_tertiaryContainer"
                android:text="@string/count_barcode_discard" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBarcodeUseAnyway"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/md_theme_onTertiaryContainer"
                tools:text="Contar 1100 de todos modos" />
        </LinearLayout>
    </LinearLayout>

    <!-- Aviso rojo: el codigo no pertenece a ninguna presentacion. -->
    <LinearLayout
        android:id="@+id/barcodeUnknownContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_banner_error"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        tools:visibility="visible">
        <TextView
            android:id="@+id/tvBarcodeUnknown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/md_theme_onErrorContainer"
            tools:text="El código 7501035911208 no está registrado en ninguna presentación." />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBarcodeAssign"
                style="@style/App.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/md_theme_error"
                android:textColor="@color/md_theme_onError"
                android:text="@string/count_barcode_assign" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBarcodeUnknownDiscard"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/md_theme_onErrorContainer"
                android:text="@string/count_barcode_discard_short" />
        </LinearLayout>
        <!-- Solo en el conteo guiado: asignar el codigo a otro producto distinto al actual. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBarcodeAssignOther"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/md_theme_onErrorContainer"
            android:text="@string/count_barcode_assign_other"
            android:visibility="gone" />
    </LinearLayout>
</merge>
