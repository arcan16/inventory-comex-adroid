<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle de solo lectura de un renglon de conteo (ver CountEntryDetailDialog). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="20dp">

    <TextView
        android:id="@+id/tvDetailRecord"
        style="@style/App.SectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Registro de conteo #1277" />

    <TextView
        android:id="@+id/tvDetailName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface"
        tools:text="REAL FLEX NF BLANCO" />

    <TextView
        android:id="@+id/tvDetailId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        tools:text="Id 1100" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/App.Field.Disabled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp">
            <TextView
                style="@style/App.Field.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/count_quantity_label" />
            <TextView
                android:id="@+id/tvDetailQuantity"
                style="@style/App.Field.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                tools:text="6.000" />
        </LinearLayout>

        <LinearLayout
            style="@style/App.Field.Disabled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                style="@style/App.Field.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/count_detail_place_label" />
            <TextView
                android:id="@+id/tvDetailPlace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                tools:text="Bodega" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
