<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/App.ListRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPresentation"
            style="@style/App.ListRow.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="4 LTS" />

        <TextView
            android:id="@+id/tvInventoryId"
            style="@style/App.ListRow.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="#48" />

        <TextView
            android:id="@+id/tvStatus"
            style="@style/App.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:background="@drawable/bg_chip_good"
            tools:textColor="@color/app_onSuccessContainer"
            tools:text="Abierto" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDate"
        style="@style/App.ListRow.Trail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="04 ene 2024" />

    <ImageView
        android:id="@+id/btnMore"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:padding="7dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_more"
        app:tint="?attr/colorOnSurfaceVariant"
        android:contentDescription="@string/nav_more" />
</LinearLayout>
