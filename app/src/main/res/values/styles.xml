<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Barra superior -->
    <style name="App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">?attr/colorOnPrimary</item>
        <item name="subtitleTextColor">?attr/colorOnPrimary</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Tarjeta generica (MaterialCardView) -->
    <style name="App.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">12dp</item>
    </style>

    <!-- Tarjeta "atenuada" (elemento anterior/siguiente en conteo guiado) -->
    <style name="App.Card.Muted" parent="App.Card">
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="strokeColor">@android:color/transparent</item>
    </style>

    <!-- Tarjeta destacada (elemento actual en conteo guiado) -->
    <style name="App.Card.Highlight" parent="App.Card">
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">1.6dp</item>
    </style>

    <!-- Campo de datos (equivalente a .field del mockup web) -->
    <style name="App.Field" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">8dp</item>
    </style>
    <style name="App.Field.Disabled">
        <item name="android:background">@drawable/bg_field_disabled</item>
    </style>
    <style name="App.Field.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
    <style name="App.Field.Value" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="App.Field.Value.Muted">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Etiqueta de seccion en mayusculas (ej. "Redes guardadas") -->
    <style name="App.SectionLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- Fila de lista -->
    <style name="App.ListRow" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:background">?attr/colorSurface</item>
    </style>
    <style name="App.ListRow.Title" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="App.ListRow.Subtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="App.ListRow.Trail" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="App.ListHeader" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- Chips de estado (TextView con fondo de pildora) -->
    <style name="App.Chip" parent="">
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">4dp</item>
    </style>
    <style name="App.Chip.Good">
        <item name="android:background">@drawable/bg_chip_good</item>
        <item name="android:textColor">@color/app_onSuccessContainer</item>
        <item name="android:drawableTint">@color/app_onSuccessContainer</item>
    </style>
    <style name="App.Chip.Warn">
        <item name="android:background">@drawable/bg_chip_warn</item>
        <item name="android:textColor">?attr/colorOnErrorContainer</item>
        <item name="android:drawableTint">?attr/colorOnErrorContainer</item>
    </style>
    <style name="App.Chip.Primary">
        <item name="android:background">@drawable/bg_chip_primary</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    </style>
    <style name="App.Chip.Accent">
        <item name="android:background">@drawable/bg_chip_accent</item>
        <item name="android:textColor">?attr/colorOnTertiaryContainer</item>
    </style>
    <style name="App.Chip.Neutral">
        <item name="android:background">@drawable/bg_chip_neutral</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Botones -->
    <style name="App.Button.Primary" parent="Widget.Material3.Button" />
    <style name="App.Button.Ghost" parent="Widget.Material3.Button.OutlinedButton" />
    <style name="App.Button.Accent" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorTertiary</item>
        <item name="android:textColor">?attr/colorOnTertiary</item>
        <item name="iconTint">?attr/colorOnTertiary</item>
    </style>
    <style name="App.Button.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">12sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Mosaico de accesos (grid de inicio / stock) -->
    <style name="App.Tile" parent="App.Card">
        <item name="contentPadding">14dp</item>
    </style>
    <style name="App.Tile.IconBadge">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

</resources>
